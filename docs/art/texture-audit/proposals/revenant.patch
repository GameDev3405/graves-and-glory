+# ---- local plate and spike (graveborn.gb_plate/gb_spike are shared by six troops; these are the Risen's own) ----
+def rv_plate(tier, seed="rp", worn=0.12, trim=False, lift=0):
+    """Grave-iron plate under top-left light: one clean bright top edge, a flat face (a lit corner column), a dark or rusted
+    lip. Tier 2 is grey salvaged iron, tier 3 black plate. `trim` pipes the foot (violet II, gilt III); `lift` sets the mass."""
+    base = (4 if tier == 2 else 2) + lift
+    def paint(face, w, h):
+        g = blank(w, h)
+        side = face not in ("top", "bottom")
+        for y in range(h):
+            for x in range(w):
+                if side: g[y][x] = clamp(GIRON, base + LIT[face] + (1 if lightx(face, x, w) > 0 else 0))
+                else: g[y][x] = clamp(GIRON, base + (2 if face == "top" else -1) - (1 if y == h - 1 else 0))
+        if side:
+            for x in range(w): g[0][x] = clamp(GIRON, base + 2 + (0 if LIT[face] >= 0 else -1) + (1 if tier == 3 else 0))
+            if h >= 3:
+                for x in range(w):
+                    if trim: g[h - 1][x] = (VIOLET[2 + (x % 2)] if tier == 2 else GILT[2 + (x % 2)])
+                    else: g[h - 1][x] = RUST[2] if tier == 2 else GIRON[1]
+            if face in ("front", "back") and w >= 4 and h >= 4:
+                g[1][1] = g[1][w - 2] = RUST[4] if tier == 2 else GILT[4]               # rivets, rust-bled on the salvaged iron
+        return g
+    return paint
+
+def rv_spike():
+    """An iron spike: dark at the root, brightening to a hard pale point (texture row 0 is the top: the point)."""
+    def paint(face, w, h):
+        g = blank(w, h)
+        for y in range(h):
+            for x in range(w):
+                t = h - 1 - y
+                g[y][x] = clamp(GIRON, 2 + (t * 4) // max(1, h - 1) + (0 if LIT[face] >= 0 else -1))
+        if face != "bottom": g[0] = [GIRON[6] if LIT[face] >= 0 else GIRON[5]] * w
+        return g
+    return paint
 
