+# ---- tier plate (local: graveborn.py is shared). II: salvaged grave-iron a clear step lighter than the mantle, hard
+# specular edges and violet piping. III: black plate, its rim chased in gilt, violet piping kept under it. ----
+def tplate(tier, seed="tp", ridge=False):
+    def paint(face, w, h):
+        g = blank(w, h); r = rnd("tplate", seed, face)
+        black = tier == 3
+        for y in range(h):
+            for x in range(w):
+                if face in ("top", "bottom"):           # rows back to front: the front row and left column catch the light
+                    if face == "bottom": g[y][x] = GI[1]; continue
+                    v = (3 if black else 4) + (1 if y == h - 1 else 0) + (1 if x == 0 else -1 if x == w - 1 else 0)
+                    g[y][x] = clamp(GI, v)
+                    if black and (y == h - 1 or x == 0) and w >= 3: g[y][x] = GILT[4 if x == 0 or x < w // 2 else 3]
+                    continue
+                lx = lightx(face, x, w)
+                v = (2 if black else 4) + LIT[face] + lx + fall(y, h, 0, -1)
+                g[y][x] = clamp(GI, v)
+        if face in ("top", "bottom"): return g
+        for x in range(w):                                # the rolled top edge
+            lx = lightx(face, x, w)
+            g[0][x] = (GILT[4 if lx > 0 else 3 if lx == 0 else 2] if black else GI[clamp(range(7), 5 + LIT[face] + lx)])
+        if h >= 3:                                        # the foot: violet piping (II) / gilt chasing over violet (III)
+            for x in range(w):
+                lx = lightx(face, x, w)
+                g[h - 1][x] = V[3 if lx >= 0 and face != "left" else 2]
+                if black and h >= 4: g[h - 2][x] = GILT[2 if lx < 0 or face == "left" else 3]
+        if face in ("front", "back") and w >= 4 and h >= 3:
+            g[1][1] = GILT[4] if black else GI[6]          # a rivet and one specular glint, by the light
+            g[1][w - 2] = GILT[2] if black else GI[4]
+            if ridge and h >= 4:
+                c = w // 2
+                for y in range(1, h - (2 if black else 1)): g[y][c - 1] = GI[5 if black else 6] if y < 3 else GI[4 if black else 5]; g[y][c] = GI[1 if black else 2]
+        if not black and face in ("front", "right", "back", "left") and w * h >= 12:   # two pits where the iron was struck
+            for _ in range(2):
+                x, y = r.randrange(1, w), r.randrange(1, max(2, h - 1))
+                if g[y][x] in GI: g[y][x] = GI[max(0, GI.index(g[y][x]) - 1)]
+        return g
+    return paint
+
+def tspike(tier):
+    """A pauldron spike: iron from the root, a bone tip (II) or a gilt tip (III)."""
+    def paint(face, w, h):
+        g = [[clamp(GI, 3 + LIT[face] + (lightx(face, x, w) if face not in ("top", "bottom") else 0) + (y * 2) // max(1, h)) for x in range(w)] for y in range(h)]
+        if face in ("top", "bottom"): return [[(GILT[4] if tier == 3 else BN[4]) if face == "top" else GI[1]] * w for _ in range(h)]
+        g[0] = [GILT[4] if tier == 3 else BN[4]] * w
+        if h > 2: g[1] = [GILT[2] if tier == 3 else BN[2]] * w
+        return g
+    return paint
+
+def tgilt(seed="tg"):
+    """Funeral gilt, flat (guide 4): tone 3, the top-left a tone up, the foot and the shade end a tone down."""
+    def paint(face, w, h):
+        out = []
+        for y in range(h):
+            row = []
+            for x in range(w):
+                if face in ("top", "bottom"): row.append(GILT[4 if face == "top" and x < w // 2 else 3 if face == "top" else 1]); continue
+                lx = lightx(face, x, w)
+                row.append(clamp(GILT, 3 + LIT[face] + (1 if lx > 0 and y == 0 else 0) - (1 if lx < 0 else 0) - (1 if y == h - 1 and h > 1 else 0)))
+            out.append(row)
+        return out
+    return paint
+
