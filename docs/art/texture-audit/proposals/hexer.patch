+# ---- tier plate (local; graveborn.gb_plate is shared): II burnished grave-iron, III black plate chased in gilt ----
+def iron_plate(tier, seed="ip"):
+    """Tier II: bright iron with a specular rolled edge, a glint and rivets, a dark foot piped in violet, so the shoulders
+    become a new pale mass at 16 blocks. Tier III: black plate, gilt chased along the edge and foot, a cold steel glint."""
+    def paint(face, w, h):
+        r = rnd("plate", seed, face, w, h); g = blank(w, h)
+        hi, base = (6, 4) if tier == 2 else (4, 2)
+        for y in range(h):
+            for x in range(w):
+                if face in ("top", "bottom"):
+                    v = base + 1 + (1 if face == "top" else -3) + (1 if face == "top" and x == 0 else 0) - (1 if x == w - 1 else 0)
+                    if face == "top" and tier == 2 and x + y == 1: v = hi                  # the specular corner
+                else:
+                    v = base + LIT[face] + lightx(face, x, w) + vf(y, h, 1, -1) + rim(face, x, w)
+                    if r.random() < 0.08: v -= 1                                             # light pitting
+                g[y][x] = clamp(GI, v)
+        if face == "top" and tier == 3 and w >= 3:
+            for x in range(w): g[h - 1][x] = GILT[3 + (x == 0)]                              # the gilt-chased front edge
+        if face not in ("top", "bottom"):
+            for x in range(w):                                                             # the rolled edge
+                g[0][x] = (clamp(GI, hi + LIT[face] + (lightx(face, x, w) > 0)) if tier == 2 else GILT[3 + (lightx(face, x, w) > 0)])
+            if h >= 3:
+                for x in range(w):
+                    if face != "left" or x % 2 == 0:
+                        g[h - 1][x] = V[2 + (x % 2)] if tier == 2 else (V[3] if x % 2 else GILT[3])   # III: gilt and violet chasing
+            if face in ("front", "back") and w >= 4 and h >= 3:
+                g[1][1] = GI[6] if tier == 2 else GILT[4]                                    # rivet
+                g[1][w - 2] = GI[5] if tier == 2 else GILT[3]
+                if w >= 5: g[1][w // 2] = GI[6] if tier == 2 else GI[5]                      # the glint
+        return g
+    return paint
+
