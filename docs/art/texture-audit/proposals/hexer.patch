+def vf(y, h, top=1, bot=-1):
+    """Vertical falloff: `top` at the first row to `bot` at the last (light from above)."""
+    return int(round(top + (bot - top) * y / max(1, h - 1)))
+
+FOLD = (-1, 0, 1, 0)     # crease, ramp up, ridge, ramp down: a long soft fold across four columns
+def foldv(face, x, off=0):
+    return FOLD[(x + off + {"front": 0, "right": 1, "back": 2, "left": 3}.get(face, 0)) % 4]
+
+def rim(face, x, w):
+    """+1 on the column that meets the top-left light (wearer's right front corner)."""
+    return 1 if (face == "front" and x == 0) or (face == "right" and x == w - 1) else 0
+
